# TypeSafe Jev via OpenRouter's Decisions API
OPENROUTER_API_KEY=your_openrouter_api_key

# Optional: Jev version. Pinned by default; re-run `bun run eval` before changing it.
# JEV_MODEL=typesafe/jev-1.14

# API Security
# Generate a secure random token: openssl rand -hex 32
API_ACCESS_TOKEN=your_secure_access_token_here

# HTTP Server Configuration
HTTP_PORT=3001
