{
  "name": "shopify-taxonomy-mapper",
  "version": "1.0.0",
  "description": "HTTP API for mapping Amazon categories and product titles to Shopify's official taxonomy using TypeSafe Jev",
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "lint": "eslint src --ext .ts --fix",
    "type-check": "tsc",
    "eval": "bun eval/iterate.ts",
    "compare": "bun eval/compare-cache.ts"
  },
  "keywords": [
    "shopify",
    "taxonomy",
    "category-mapping",
    "amazon",
    "jev",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  }
}
