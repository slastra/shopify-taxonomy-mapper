{
  "name": "shopify-taxonomy-mapper",
  "version": "1.0.0",
  "description": "HTTP API for mapping Amazon categories and product titles to Shopify's official taxonomy using Amazon Nova Lite",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "bun run build && bun --watch src/server.ts",
    "start": "bun run build && bun src/server.ts",
    "lint": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "eval": "bun eval/eval-models.ts",
    "measure-cache": "bun eval/measure-cache.ts"
  },
  "keywords": [
    "shopify",
    "taxonomy",
    "category-mapping",
    "amazon",
    "nova-lite",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1041.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.19.17",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
